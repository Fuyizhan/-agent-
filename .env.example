# 可选：配置任一 OpenAI 兼容模型端点。未配置时自动使用规则降级。
LLM_PROVIDER=auto
CONTRACT_LLM_API_KEY=
CONTRACT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CONTRACT_LLM_MODEL=qwen-max

MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.7

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 生产环境必须替换为至少 32 字符的随机密钥。
JWT_SECRET_KEY=local-only-jwt-secret-change-before-production-64-characters
MAX_UPLOAD_SIZE_MB=20
